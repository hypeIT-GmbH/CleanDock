    },
    "Add apps to this profile": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps zu diesem Profil hinzufügen"
          }
        }
      }
    },
    "Administrators can deploy read-only profiles to this folder via MDM.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratoren können über MDM schreibgeschützte Profile in diesem Ordner bereitstellen."
