    "%lld selected": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ausgewählt"
          }
        }
      }
    },
    "A backup of the Dock is written before every load; the ten most recent are kept. Restoring puts that Dock back - the current Dock is saved as a new backup first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor jedem Laden wird ein Backup des Docks angelegt; die zehn neuesten bleiben erhalten. Wiederherstellen setzt das Dock auf diesen Stand zurück - das aktuelle Dock wird vorher als neues Backup gesichert."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Info"
          }
        }
      }
    },
