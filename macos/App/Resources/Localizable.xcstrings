          "stringUnit": {
            "state": "translated",
            "value": "Profil hinzufügen"
          }
        }
      }
    },
    "Add apps from the picker, drag them in from the Finder, or choose them from a file dialog.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Apps über den Picker hinzu, ziehe sie aus dem Finder hierher oder wähle sie über den Dateidialog."
