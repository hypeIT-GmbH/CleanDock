<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>de.hypeit.cleandock.apply</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/CleanDock.app/Contents/Helpers/cleandock</string>
        <string>apply</string>
        <string>--managed</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Ties the login item to the app, so the "background item added"
         notification and System Settings list it under CleanDock instead
         of a bare agent label. -->
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>de.hypeit.cleandock</string>
    </array>
</dict>
</plist>
